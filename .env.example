# Base
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/financeiro

# Auth/OIDC
OIDC_CLIENT_ID=financeiro-local
OIDC_CLIENT_SECRET=change-me
OIDC_ISSUER=https://auth.local/realms/financeiro
JWT_SECRET=super-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Storage
STORAGE_BUCKET=financeiro-demo
STORAGE_REGION=us-east-1

# Feature flags
NEXT_PUBLIC_FEATURE_PIX_BOLETO=true
